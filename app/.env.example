# Copy to app/.env and fill in. Never commit app/.env.

# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database ---
# Leave both empty to use the local Postgres container from docker-compose.
# To use Neon, run `neon env pull --file app/.env` (or paste the two connection
# strings from the Neon console as-is):
#   DATABASE_URL           pooled ("-pooler" in the host), for the app
#   DATABASE_URL_UNPOOLED  direct, for migrations
# Tests always use a separate local database, never these.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth ---
# Login sessions last this many hours.
SESSION_TTL_HOURS=12
# Send the session cookie over HTTPS only. Must be true in production.
COOKIE_SECURE=false
# Sign-in attempts per client IP, and failed attempts per account.
LOGIN_RATE_LIMIT=10/minute
LOGIN_ACCOUNT_FAILURE_LIMIT=20/hour
# New customer accounts per client IP.
SIGNUP_RATE_LIMIT=5/hour

# --- Worker ---
# The API wakes the worker over HTTP when it queues a job (set by docker-compose).
# The sweep only catches a missed wake-up; keep it long so Neon can scale to zero.
WORKER_SWEEP_SECONDS=1800

# --- Return photo storage ---
# Leave AWS_ENDPOINT_URL_S3 empty to keep photos in app/storage/ on this machine.
# For Neon Object Storage (private bucket `return-photos`, declared in neon.ts),
# `neon env pull --file app/.env` fills in all four AWS_* values.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
STORAGE_BUCKET=return-photos
# Uploads are capped at this size (bytes); bigger photos are refused.
UPLOAD_MAX_BYTES=10485760

# --- Rate limits on checkout and starting a return (per client IP) ---
CHECKOUT_RATE_LIMIT=10/minute
RETURN_RATE_LIMIT=10/minute

# --- Policy RAG (M5) ---
# Leave OPENAI_API_KEY blank to run without it: review_return()'s default
# (RuleSteps) needs none of this. Set it to enable `make embed-policy` and the
# real model-backed pipeline steps (policy, photo, recommendation, critic).
# Never commit a real key.
OPENAI_API_KEY=
# Only the chat call honors this (an OpenAI-compatible endpoint, e.g. another
# provider's). Embeddings always go straight to OpenAI — see config.py.
OPENAI_CHAT_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
POLICY_MODEL=gpt-4o-mini
POLICY_RETRIEVAL_K=4

# --- Added in later milestones (leave blank for now) ---
GROQ_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
