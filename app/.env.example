# Copy to app/.env and fill in. Never commit app/.env.

# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database ---
# Leave both empty to use the local Postgres container from docker-compose.
# To use Neon, run `neon env pull --file app/.env` (or paste the two connection
# strings from the Neon console as-is):
#   DATABASE_URL           pooled ("-pooler" in the host), for the app
#   DATABASE_URL_UNPOOLED  direct, for migrations
# Tests always use a separate local database, never these.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth ---
# Login sessions last this many hours.
SESSION_TTL_HOURS=12
# Send the session cookie over HTTPS only. Must be true in production.
COOKIE_SECURE=false
# Sign-in attempts per client IP, and failed attempts per account.
LOGIN_RATE_LIMIT=10/minute
LOGIN_ACCOUNT_FAILURE_LIMIT=20/hour
# New customer accounts per client IP.
SIGNUP_RATE_LIMIT=5/hour

# --- Worker ---
# The API wakes the worker over HTTP when it queues a job (set by docker-compose).
# The sweep only catches a missed wake-up; keep it long so Neon can scale to zero.
WORKER_SWEEP_SECONDS=1800

# --- Return photo storage ---
# Leave AWS_ENDPOINT_URL_S3 empty to keep photos in app/storage/ on this machine.
# For Neon Object Storage (private bucket `return-photos`, declared in neon.ts),
# `neon env pull --file app/.env` fills in all four AWS_* values.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
STORAGE_BUCKET=return-photos
# Uploads are capped at this size (bytes); bigger photos are refused.
UPLOAD_MAX_BYTES=10485760

# --- Rate limits on checkout, starting a return, and chat messages (per client IP) ---
CHECKOUT_RATE_LIMIT=10/minute
RETURN_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=20/minute

# --- Model providers (M5) ---
# Leave the keys blank to run without a model: review_return() then uses
# RuleSteps. With both a chat and an embedding key set, the model-backed steps
# run (policy, photo, recommendation, critic, chat assist). Any OpenAI-compatible
# provider works; a blank base URL means OpenAI. Never commit a real key.
# (OPENAI_API_KEY / OPENAI_CHAT_BASE_URL / POLICY_MODEL still work as fallbacks.)
#
# Chat + vision. Example: Qwen on Groq.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=qwen/qwen3.8-27b
CHAT_TEMPERATURE=0
# Provider-specific request fields as JSON. For Qwen on Groq, "none" turns
# reasoning off: faster and far fewer tokens. Use {} to send nothing extra.
CHAT_EXTRA_BODY={"reasoning_effort": "none"}
# Groq's free tier allows few tokens per minute and one review makes 4 calls;
# retries wait out the 429s using the provider's Retry-After.
CHAT_MAX_RETRIES=5
#
# Embeddings for Policy RAG (Groq has none). The model must return 1536
# dimensions (policy_chunks.embedding). After changing it, clear
# policy_chunks.embedding and run `make embed-policy`.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# Only for models that can shorten their output (e.g. text-embedding-3-*).
EMBEDDING_DIMENSIONS=
POLICY_RETRIEVAL_K=4

# --- Added in later milestones (leave blank for now) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
