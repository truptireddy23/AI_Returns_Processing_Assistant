# Copy to app/.env and fill in. Never commit app/.env.

# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# Used when running the backend outside Docker (make dev-api, make test).
# Inside Docker Compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://returnguard:returnguard@localhost:5432/returnguard

# --- Added in later milestones (leave blank for now) ---
# M2: session signing
SESSION_SECRET=
# M5: model providers and tracing
GROQ_API_KEY=
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
