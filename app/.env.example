# Copy to app/.env and fill in. Never commit app/.env.

# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database ---
# Leave both empty to use the local Postgres container from docker-compose.
# To use Neon, run `neon env pull --file app/.env` (or paste the two connection
# strings from the Neon console as-is):
#   DATABASE_URL           pooled ("-pooler" in the host), for the app
#   DATABASE_URL_UNPOOLED  direct, for migrations
# Tests always use a separate local database, never these.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth ---
# Login sessions last this many hours.
SESSION_TTL_HOURS=12
# Send the session cookie over HTTPS only. Must be true in production.
COOKIE_SECURE=false
# Sign-in attempts per client IP, and failed attempts per account.
LOGIN_RATE_LIMIT=10/minute
LOGIN_ACCOUNT_FAILURE_LIMIT=20/hour

# --- Added in later milestones (leave blank for now) ---
# M5: model providers and tracing
GROQ_API_KEY=
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
