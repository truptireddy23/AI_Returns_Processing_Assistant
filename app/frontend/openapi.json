{
  "components": {
    "schemas": {
      "AuthState": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "user",
          "csrf_token"
        ],
        "title": "AuthState",
        "type": "object"
      },
      "Decision": {
        "enum": [
          "approve",
          "deny",
          "escalate"
        ],
        "title": "Decision",
        "type": "string"
      },
      "EscalationReason": {
        "description": "Named reasons a case is in the reviewer queue (BUILD_PLAN.md section 5).",
        "enum": [
          "pipeline_error",
          "proposed_denial",
          "ambiguous_call",
          "unverified_photo",
          "critic_concern",
          "high_value",
          "elevated_risk",
          "automation_off",
          "qa_sample",
          "customer_requested_review"
        ],
        "title": "EscalationReason",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OrderItemOut": {
        "properties": {
          "category": {
            "$ref": "#/components/schemas/ProductCategory"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "is_final_sale": {
            "title": "Is Final Sale",
            "type": "boolean"
          },
          "product_name": {
            "title": "Product Name",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "unit_price_cents": {
            "title": "Unit Price Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "product_name",
          "category",
          "quantity",
          "unit_price_cents",
          "is_final_sale"
        ],
        "title": "OrderItemOut",
        "type": "object"
      },
      "OrderOut": {
        "properties": {
          "card_last4": {
            "title": "Card Last4",
            "type": "string"
          },
          "delivered_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Delivered At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemOut"
            },
            "title": "Items",
            "type": "array"
          },
          "order_number": {
            "title": "Order Number",
            "type": "integer"
          },
          "placed_at": {
            "format": "date-time",
            "title": "Placed At",
            "type": "string"
          },
          "total_cents": {
            "title": "Total Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "order_number",
          "placed_at",
          "delivered_at",
          "total_cents",
          "card_last4",
          "items"
        ],
        "title": "OrderOut",
        "type": "object"
      },
      "ProductCategory": {
        "enum": [
          "footwear",
          "clothing",
          "electronics",
          "home"
        ],
        "title": "ProductCategory",
        "type": "string"
      },
      "QueueItem": {
        "properties": {
          "ai_proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Decision"
              },
              {
                "type": "null"
              }
            ]
          },
          "case_number": {
            "title": "Case Number",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "escalation_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EscalationReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "refund_amount_cents": {
            "title": "Refund Amount Cents",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "case_number",
          "refund_amount_cents",
          "ai_proposal",
          "escalation_reason",
          "created_at"
        ],
        "title": "QueueItem",
        "type": "object"
      },
      "Role": {
        "enum": [
          "customer",
          "reviewer",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "SettingsOut": {
        "properties": {
          "automation_enabled": {
            "title": "Automation Enabled",
            "type": "boolean"
          },
          "high_value_limit_cents": {
            "title": "High Value Limit Cents",
            "type": "integer"
          },
          "qa_sample_rate": {
            "title": "Qa Sample Rate",
            "type": "string"
          },
          "risk_limit": {
            "title": "Risk Limit",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "automation_enabled",
          "risk_limit",
          "high_value_limit_cents",
          "qa_sample_rate",
          "updated_at"
        ],
        "title": "SettingsOut",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "role"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ReturnGuard API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/settings": {
      "get": {
        "operationId": "get_settings_api_admin_settings_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Settings",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthState"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthState"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/healthz": {
      "get": {
        "description": "Liveness: the process is up.",
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Api Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "list_my_orders_api_orders_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrderOut"
                  },
                  "title": "Response List My Orders Api Orders Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List My Orders",
        "tags": [
          "orders"
        ]
      }
    },
    "/api/readyz": {
      "get": {
        "description": "Readiness: the process can reach its dependencies.",
        "operationId": "readyz_api_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Readyz Api Readyz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/api/review/queue": {
      "get": {
        "operationId": "queue_api_review_queue_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QueueItem"
                  },
                  "title": "Response Queue Api Review Queue Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Queue",
        "tags": [
          "review"
        ]
      }
    }
  }
}
